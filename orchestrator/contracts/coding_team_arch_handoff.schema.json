{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coding_team_arch_handoff.schema.json",
  "type": "object",
  "required": ["from_step", "to_steps", "modules", "interfaces", "decisions", "risks"],
  "properties": {
    "from_step": { "type": "string", "minLength": 1 },
    "to_steps": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "interfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "risks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": true
}
