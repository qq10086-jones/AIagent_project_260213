{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "worker_coding_cohort_plan.schema.json",
  "type": "object",
  "required": [
    "version",
    "cohort_id",
    "tasks"
  ],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "cohort_id": { "type": "string", "minLength": 1 },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "cohort_task_id",
          "task_class",
          "beta_template_id",
          "scenario",
          "validation_focus",
          "verification_tier_target"
        ],
        "properties": {
          "cohort_task_id": { "type": "string", "minLength": 1 },
          "task_class": { "type": "string", "minLength": 1 },
          "beta_template_id": { "type": "string", "minLength": 1 },
          "scenario": { "type": "string", "minLength": 1 },
          "validation_focus": { "type": "string", "minLength": 1 },
          "verification_tier_target": { "type": "string", "minLength": 1 },
          "target_path_hints": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "required_artifacts": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "likely_failure_attribution": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
