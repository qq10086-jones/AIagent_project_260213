{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "worker_coding_cohort_result.schema.json",
  "type": "object",
  "required": [
    "cohort_run_id",
    "generated_at",
    "summary",
    "results"
  ],
  "properties": {
    "cohort_run_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "summary": {
      "type": "object",
      "required": ["total_runs", "pass_count", "fail_count", "partial_count"],
      "properties": {
        "total_runs": {},
        "pass_count": {},
        "fail_count": {},
        "partial_count": {}
      },
      "additionalProperties": true
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "cohort_id",
          "task_class",
          "beta_template_id",
          "verification_tier_target",
          "verification_tier_achieved",
          "result",
          "failure_attribution"
        ],
        "properties": {
          "cohort_id": { "type": "string", "minLength": 1 },
          "task_class": { "type": "string", "minLength": 1 },
          "beta_template_id": { "type": "string", "minLength": 1 },
          "verification_tier_target": { "type": "string", "minLength": 1 },
          "verification_tier_achieved": { "type": "string", "minLength": 1 },
          "result": { "type": "string", "minLength": 1 },
          "failure_attribution": { "type": "string", "minLength": 1 },
          "operator_note": { "type": "string" },
          "run_id": { "type": "string" },
          "task_id": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
