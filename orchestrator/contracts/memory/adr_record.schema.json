{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AdrRecord",
  "type": "object",
  "required": ["adr_id", "title", "status", "decision"],
  "properties": {
    "adr_id": { "type": "string" },
    "title": { "type": "string" },
    "status": { "enum": ["Accepted", "Proposed", "Superseded"] },
    "context": { "type": "string" },
    "decision": { "type": "string" },
    "consequences": { "type": "string" },
    "alternatives_considered": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
