{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BrainRouterPolicyResult",
  "type": "object",
  "required": ["applied_rule", "decision", "intent", "override"],
  "properties": {
    "applied_rule": { "type": ["string", "null"] },
    "decision": { "enum": ["direct_reply", "single_agent", "orchestrated_workflow", "human_review_required"] },
    "intent": { "enum": ["chat", "coding", "quant", "docs", "research", "ops", "unknown"] },
    "override": { "type": "boolean" },
    "error_note": { "type": "string" }
  }
}
