{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coding_team_arch_handoff.schema.json",
  "type": "object",
  "required": ["from_step", "to_steps", "modules", "interfaces", "decisions", "risks", "workplan"],
  "properties": {
    "from_step": { "type": "string", "minLength": 1 },
    "to_steps": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "workplan": {
      "type": "object",
      "required": ["be_tasks", "fe_tasks"],
      "properties": {
        "be_tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "description", "verify"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "verify": { "type": "string", "minLength": 1 }
            }
          }
        },
        "fe_tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "description", "verify"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "verify": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "interfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["adr_id", "title", "status"],
        "properties": {
          "adr_id": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    },
    "risks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "parallelization": {
      "type": "object",
      "properties": {
        "fe_safe_parallel": { "type": "boolean" },
        "requires_be_handoff": { "type": "boolean" },
        "rationale": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
