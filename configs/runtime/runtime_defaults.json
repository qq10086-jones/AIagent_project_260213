{
  "version": "1.0",
  "orchestrator": {
    "qwen_base_url": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
    "qwen_model": "qwen-flash",
    "coder_provider_default": "opencode",
    "coder_model_default": "qwen3-coder-plus-2025-07-22",
    "quant_llm_model": "qwen-plus-2025-04-28",
    "workflow_step_artifact_audit": true,
    "workflow_strict_step_artifacts": true,
    "approval_token_default": "dev-approval-token"
  },
  "execution": {
    "diff_first_enabled": true
  },
  "brain": {
    "llm_provider": "dashscope",
    "qwen_base_url": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
    "qwen_model": "qwen-flash",
    "quant_llm_model": "qwen-plus-2025-04-28",
    "ollama_base_url": "http://host.docker.internal:11434",
    "llm_timeout_sec": 60
  },
  "worker_coder": {
    "provider_default": "opencode",
    "model_default": "qwen3-coder-plus-2025-07-22",
    "global_task_timeout_ms": 900000,
    "verification_command_default": "",
    "max_attempts_default": 2,
    "same_error_repeat_limit_default": 2,
    "wall_clock_timeout_s_default": 480
  },
  "worker_quant": {
    "llm_provider": "dashscope",
    "quant_llm_model": "qwen-plus-2025-04-28",
    "code_llm_model": "qwen-flash-2025-07-28",
    "dash_scope_base_url": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
    "openai_base_url": "https://api.openai.com/v1",
    "ollama_base_url": "http://host.docker.internal:11434",
    "llm_timeout_s": 25
  },
  "watchdog": {
    "running_timeout_sec": 900,
    "queued_timeout_sec": 21600,
    "interval_sec": 30,
    "auto_dlq": true
  },
  "streams": {
    "task_dlq": "stream:task:dlq"
  }
}
