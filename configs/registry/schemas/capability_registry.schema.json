{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nexus Capability Registry",
  "type": "object",
  "required": ["version", "project_types", "roles", "tools", "workflows", "acceptance_suites"],
  "properties": {
    "version": { "type": "string" },
    "project_types": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["default_worker", "risk_profile"],
        "properties": {
          "default_worker": { "type": "string" },
          "default_workflow": { "type": "string" },
          "risk_profile": { "type": "string" },
          "acceptance_suite": { "type": "string" },
          "required_artifacts": {
            "type": "array",
            "items": { "type": "string" }
          },
          "policy": {
            "type": "object",
            "properties": {
              "auto_approve_paths": { "type": "array", "items": { "type": "string" } },
              "manual_approve_paths": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["tools"],
        "properties": {
          "tools": { "type": "array", "items": { "type": "string" } },
          "description": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": { "type": "string" },
          "params": {
            "type": "object",
            "properties": {
              "properties": { "type": "object" },
              "required": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "workflows": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["project_type", "steps"],
        "properties": {
          "project_type": { "type": "string" },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "role", "tool"],
              "properties": {
                "id": { "type": "string" },
                "role": { "type": "string" },
                "tool": { "type": "string" },
                "gate": { "type": "string" },
                "prompt_script_id": { "type": "string" },
                "depends_on": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "acceptance_suites": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "commands": { "type": "array", "items": { "type": "string" } },
          "required_reports": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
