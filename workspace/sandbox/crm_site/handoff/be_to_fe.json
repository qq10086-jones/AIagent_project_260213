{
  "from_step": "impl_be",
  "to_step": "impl_fe",
  "be_changes_path": "impl/be_changes",
  "api_contracts": [
    {
      "name": "List Customers",
      "method": "GET",
      "path": "/api/customers",
      "auth": "none",
      "response": "{ data: Customer[] }"
    },
    {
      "name": "Get Customer",
      "method": "GET",
      "path": "/api/customers/:id",
      "auth": "none",
      "response": "{ success: true, data: Customer }"
    },
    {
      "name": "Create Customer",
      "method": "POST",
      "path": "/api/customers",
      "auth": "none",
      "request": "{ name: string, email: string, phone?: string, company?: string, notes?: string }",
      "response": "{ success: true, data: Customer }"
    },
    {
      "name": "Update Customer",
      "method": "PUT",
      "path": "/api/customers/:id",
      "auth": "none",
      "request": "{ name?: string, email?: string, phone?: string, company?: string, notes?: string }",
      "response": "{ success: true, data: Customer }"
    }
  ],
  "shared_types": [
    {
      "name": "Customer",
      "fields": {
        "id": "string",
        "name": "string",
        "email": "string",
        "phone": "string",
        "company": "string",
        "notes": "string",
        "createdAt": "string (ISO8601)",
        "updatedAt": "string (ISO8601)"
      }
    },
    {
      "name": "CustomerCreateRequest",
      "fields": {
        "name": "string (required)",
        "email": "string (required)",
        "phone": "string (optional)",
        "company": "string (optional)",
        "notes": "string (optional)"
      }
    },
    {
      "name": "CustomerUpdateRequest",
      "fields": {
        "name": "string (optional)",
        "email": "string (optional)",
        "phone": "string (optional)",
        "company": "string (optional)",
        "notes": "string (optional)"
      }
    }
  ],
  "scope_constraints": [
    "In-memory data store (Map) - data resets on server restart",
    "No authentication (per ADR-004)",
    "No CSRF protection",
    "Customer CRUD only - no other entities",
    "No pagination - returns all customers",
    "Static files served from impl/be_changes/public/",
    "SPA fallback: GET / returns public/index.html"
  ]
}
