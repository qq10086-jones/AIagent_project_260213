.pytest_cache/
.pytest_tmp/
pytest_cache/
pytest_tmp/
__pycache__/
*.pyc
.runtime/
.superpowers/

# Original design packages (quant.zip, quant0530.zip, …) — kept locally as
# reference; do not version-track. Frontend assets extracted from them ARE tracked.
quant.zip
*.zip

# Decision-log + outcome storage (runtime artifacts; recreated per session).
reports/predictions/
reports/outcomes/

data/raw/*
data/interim/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

reports/daily/*
reports/backtests/*
reports/paper/*
!reports/daily/.gitkeep
!reports/backtests/.gitkeep
!reports/paper/.gitkeep

# All reports/ SUBDIRECTORIES are runtime artifacts (predictions, outcomes,
# tdnet/tdnet_docs PDFs, adr, news, macro, observability traces, research
# cohorts, the personal portfolio journal, calibration snapshots) — recreated
# by the collection tools and backed up separately; never version-tracked.
# Root-level tracked files (e.g. reports/recalibrator_isotonic_v1.json) are a
# file, not a subdir, so this rule leaves them tracked.
reports/*/
!reports/*/.gitkeep

# Local backup archives + backend backup snapshots.
_htr_backups/
frontend_zerobuild_backup_*/
