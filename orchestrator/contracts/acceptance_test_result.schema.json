{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acceptance_test_result.schema.json",
  "type": "object",
  "required": ["criteria_results", "verdict", "generated_at"],
  "properties": {
    "criteria_results": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["id", "description", "verify_tier", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "verify_tier": { "type": "string", "enum": ["deterministic", "semantic", "manual"] },
          "verify_command": { "type": "string" },
          "expected_pattern": { "type": "string" },
          "status": { "type": "string", "enum": ["pass", "fail", "skip", "error"] },
          "stdout": { "type": "string" },
          "stderr": { "type": "string" },
          "error": { "type": "string" },
          "evidence": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "deterministic_pass": { "type": "integer" },
    "deterministic_fail": { "type": "integer" },
    "semantic_pending": { "type": "integer" },
    "verdict": { "type": "string", "enum": ["pass", "fail", "no_deterministic_criteria"] },
    "generated_at": { "type": "string" }
  },
  "additionalProperties": true
}
