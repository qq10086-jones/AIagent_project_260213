{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "frontend_execution_packet.schema.json",
  "type": "object",
  "required": [
    "adapter_id",
    "role",
    "step_id",
    "target_paths",
    "required_outputs",
    "input_artifacts",
    "execution_mode"
  ],
  "properties": {
    "adapter_id": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1 },
    "step_id": { "type": "string", "minLength": 1 },
    "target_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "required_outputs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "input_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "execution_mode": { "type": "string", "minLength": 1 },
    "verification_hint": { "type": "string" },
    "provider_hint": { "type": "string" },
    "model_hint": { "type": "string" }
  },
  "additionalProperties": true
}
