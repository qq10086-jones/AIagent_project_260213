{
  "version": "1.0",
  "orchestrator": {
    "qwen_base_url": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
    "qwen_model": "qwen-flash",
    "coder_provider_default": "opencode",
    "coder_model_default": "minimax-coding-plan/MiniMax-M2.7",
    "quant_llm_model": "qwen-plus-2025-04-28",
    "workflow_step_artifact_audit": true,
    "workflow_strict_step_artifacts": true,
    "approval_token_default": "dev-approval-token",
    "fidelity_gate_mode": "blocking"
  },
  "execution": {
    "diff_first_enabled": true
  },
  "brain": {
    "llm_provider": "minimax",
    "minimax_base_url": "https://api.minimaxi.com/v1",
    "qwen_model": "MiniMax-M2.7",
    "quant_llm_model": "MiniMax-M2.7",
    "ollama_base_url": "http://host.docker.internal:11434",
    "llm_timeout_sec": 60
  },
  "worker_coder": {
    "provider_default": "opencode",
    "model_default": "minimax-coding-plan/MiniMax-M2.7",
    "global_task_timeout_ms": 1800000,
    "verification_command_default": "",
    "max_attempts_default": 2,
    "same_error_repeat_limit_default": 2,
    "wall_clock_timeout_s_default": 900,
    "execution_lane_default": "stable_cloud_lane",
    "allow_provider_fallback_default": false,
    "stream_batch_size": 1,
    "surgical_patch_enabled": true,
    "refinement_reentry_enabled": true,
    "context_resolver_enabled": true,
    "project_planner_enabled": false,
    "project_planner_max_runs": 12,
    "project_planner_max_parallel_runs": 2,
    "project_planner_failure_policy": "stop_dependents",
    "project_planner_confirm_mode": "manual",
    "project_planner_llm_provider": "auto",
    "project_planner_ollama_model": "gemma4:26b",
    "execution_lanes": {
      "stable_codex_lane": {
        "provider": "codex",
        "model": "codex-mini-latest",
        "provider_class": "codex-cli",
        "purpose": "stable codex lane using OpenAI Codex CLI with OPENAI_API_KEY"
      },
      "stable_cloud_lane": {
        "provider": "opencode",
        "model": "minimax-coding-plan/MiniMax-M2.7",
        "provider_class": "opencode-provider",
        "purpose": "stable cloud lane via opencode using MiniMax M2.7"
      },
      "stable_local_lane": {
        "provider": "opencode",
        "model": "ollama/glm-4.7-flash:latest",
        "provider_class": "opencode-provider",
        "purpose": "stable local recovery lane for high-resource machines"
      },
      "stable_dashscope_lane": {
        "provider": "opencode",
        "model": "dashscope/qwen-plus-2025-04-28",
        "provider_class": "opencode-provider",
        "purpose": "DashScope Qwen Plus lane (16K output cap)"
      },
      "primary_minimax_lane": {
        "provider": "opencode",
        "model": "minimax-coding-plan/MiniMax-M2.7",
        "provider_class": "opencode-provider",
        "purpose": "primary MiniMax lane retained for release/deploy and generic_app implementation"
      }
    }
  },
  "worker_quant": {
    "llm_provider": "minimax",
    "quant_llm_model": "MiniMax-M2.7",
    "code_llm_model": "MiniMax-M2.7",
    "minimax_base_url": "https://api.minimaxi.com/v1",
    "openai_base_url": "https://api.openai.com/v1",
    "ollama_base_url": "http://host.docker.internal:11434",
    "llm_timeout_s": 25
  },
  "watchdog": {
    "running_timeout_sec": 1800,
    "queued_timeout_sec": 21600,
    "interval_sec": 30,
    "auto_dlq": true
  },
  "streams": {
    "task_dlq": "stream:task:dlq"
  }
}
