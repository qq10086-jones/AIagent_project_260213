{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openclaw-nexus/discord_request.schema.json",
  "title": "DiscordRequest",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "source": {
      "type": "string",
      "const": "discord"
    },
    "raw_input": {
      "type": "string",
      "minLength": 1
    },
    "channel_id": {
      "type": "string"
    },
    "thread_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "filename": { "type": "string" },
          "url": { "type": "string" },
          "content_type": { "type": "string" }
        }
      }
    },
    "provider": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "fast_mode": {
      "type": "boolean"
    },
    "model_preference": {
      "type": "string",
      "enum": ["auto", "local", "api"]
    }
  },
  "required": ["source", "raw_input"]
}
