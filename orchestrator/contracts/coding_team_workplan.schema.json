{
  "$id": "coding_team_workplan.schema.json",
  "type": "object",
  "required": ["be_tasks", "fe_tasks"],
  "properties": {
    "be_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "verify"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "verify": { "type": "string", "minLength": 1 }
        }
      }
    },
    "fe_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "verify"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "verify": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
